# Application
APP_HOST=0.0.0.0
APP_PORT=8010
ECHO_PORT=8010
APP_DEBUG=false
APP_RELOAD=false
CORS_ORIGINS=http://localhost:8010
LOG_LEVEL=INFO

# Local development database. Use mysql only for shared deployment.
DB_TYPE=sqlite
SQLITE_PATH=data/echo.db
MYSQL_USER=echo
MYSQL_PASSWORD=replace-me
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=echo

# Authentication. Replace both values outside local development.
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE=60

# Optional first administrator. Set both only during initial deployment, then remove them.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# OpenAI-compatible model endpoint
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# PunditRAG uses separate native import and query services.
PUNDITRAG_IMPORT_BASE_URL=http://localhost:8000
PUNDITRAG_QUERY_BASE_URL=http://localhost:8001
PUNDITRAG_DOCKER_IMPORT_BASE_URL=http://host.docker.internal:8000
PUNDITRAG_DOCKER_QUERY_BASE_URL=http://host.docker.internal:8001
PUNDITRAG_TIMEOUT_SECONDS=30
PUNDITRAG_TOP_K=5

# Independent team services
SIMPLEMEM_BASE_URL=http://localhost:8020
SIMPLEMEM_DOCKER_BASE_URL=http://simplemem:8020
SIMPLEMEM_TIMEOUT_SECONDS=10
SIMPLEMEM_HOST=127.0.0.1
SIMPLEMEM_PORT=8020
SIMPLEMEM_DB_PATH=data/simplemem.db
# Required for normal startup. Generate a strong random value and use the same value in ECHO.
SIMPLEMEM_API_KEY=
# Local loopback development only. Never enable this on a network-reachable deployment.
SIMPLEMEM_ALLOW_INSECURE_DEV=false
MICRO_REPRESENTATION_BASE_URL=http://localhost:8030
MICRO_REPRESENTATION_DOCKER_BASE_URL=http://host.docker.internal:8030
MICRO_REPRESENTATION_TIMEOUT_SECONDS=15
MICRO_DETECTOR_PORT=8030
MICRO_CALLBACK_SECRET=

# Local file paths
UPLOAD_DIR=data/uploads
MAX_FILE_SIZE=104857600
