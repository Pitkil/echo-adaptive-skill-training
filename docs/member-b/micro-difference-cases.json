{
  "version": "b-micro-cases-v1",
  "purpose": "成员 B 微表征接口、权限、汇总和降级的冻结差异案例；不包含真实音频，不用于检测准确率指标。",
  "cases": [
    {
      "case_id": "B-MICRO-01",
      "learner_profile": "P1",
      "module": "M1",
      "source_type": "learner_voice",
      "scenario": "学习者授权提交本人单轮录音，检测器返回已确认犹豫事件",
      "expected": ["创建任务", "保存可定位时间点", "交给学习画像作为辅助证据", "不修改U/A/R"]
    },
    {
      "case_id": "B-MICRO-02",
      "learner_profile": "P2",
      "module": "M2",
      "source_type": "learner_voice",
      "scenario": "学习者未授权录音分析",
      "expected": ["拒绝请求", "不保存音频", "不创建检测任务"]
    },
    {
      "case_id": "B-MICRO-03",
      "learner_profile": "P3",
      "module": "M3",
      "source_type": "learner_voice",
      "scenario": "同一业务范围重复提交相同录音",
      "expected": ["返回原任务", "不重复上传检测器", "不重复统计"]
    },
    {
      "case_id": "B-MICRO-04",
      "learner_profile": "P1",
      "module": "M2",
      "source_type": "mentor_recording",
      "scenario": "讲师上传多人录音但未确认说话人",
      "expected": ["learner_id为空", "事件只进入课次统计", "不进入个人画像"]
    },
    {
      "case_id": "B-MICRO-05",
      "learner_profile": "P2",
      "module": "M3",
      "source_type": "mentor_recording",
      "scenario": "讲师确认说话人并绑定同组织学习者",
      "expected": ["保存确认事件", "课次汇总包含事件", "允许作为个人辅助证据"]
    },
    {
      "case_id": "B-MICRO-06",
      "learner_profile": "P3",
      "module": "M1",
      "source_type": "mentor_recording",
      "scenario": "事件声明的学习者与检测任务不一致",
      "expected": ["整批拒绝", "不部分写入", "记录同步失败原因"]
    },
    {
      "case_id": "B-MICRO-07",
      "learner_profile": "P1",
      "module": "M3",
      "source_type": "learner_voice",
      "scenario": "检测服务连接失败后学习者查询任务",
      "expected": ["任务保持awaiting_detector", "返回明确降级原因", "允许安全重试"]
    },
    {
      "case_id": "B-MICRO-08",
      "learner_profile": "P2",
      "module": "M1",
      "source_type": "mentor_recording",
      "scenario": "检测完成且合法返回空事件",
      "expected": ["事件同步状态为synced", "信号总数为0", "不伪造检测事件"]
    },
    {
      "case_id": "B-MICRO-09",
      "learner_profile": "P3",
      "module": "M2",
      "source_type": "mentor_recording",
      "scenario": "一批录音中部分任务缺少audio_duration_ms",
      "expected": ["保留有效事件统计", "前后趋势不可用", "返回明确降级原因"]
    },
    {
      "case_id": "B-MICRO-10",
      "learner_profile": "P1",
      "module": "M1",
      "source_type": "mentor_recording",
      "scenario": "不同讲师在同一业务范围提交相同录音",
      "expected": ["不创建第二个检测任务", "后上传者看不到原任务详情", "不重复计入汇总"]
    }
  ]
}
